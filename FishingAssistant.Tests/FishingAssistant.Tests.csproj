<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <EnableGameDebugging>false</EnableGameDebugging>
    <EnableModDeploy>false</EnableModDeploy>
    <EnableModZip>false</EnableModZip>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FishingAssistant\FishingAssistant.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\Fixtures\*.json" />
  </ItemGroup>

  <Target Name="CopySmapiRuntimeForTests" AfterTargets="Build">
    <ItemGroup>
      <TestRuntimeAssembly Include="$(GamePath)\*.dll" />
      <TestRuntimeAssembly Include="$(GamePath)\smapi-internal\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(TestRuntimeAssembly)" DestinationFolder="$(TargetDir)" />
  </Target>
</Project>
